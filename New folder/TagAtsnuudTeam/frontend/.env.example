# Frontend Environment Variables

# API Configuration
VITE_APP_API_URL=http://localhost:5000/api/v1

# Optional: App name and version
VITE_APP_NAME=HallBook
VITE_APP_VERSION=1.0.0

# Optional: Analytics & Monitoring
# VITE_APP_SENTRY_DSN=
# VITE_APP_GOOGLE_ANALYTICS_ID=

# Optional: Feature Flags
VITE_APP_ENABLE_NOTIFICATIONS=true
VITE_APP_ENABLE_MESSAGING=false
